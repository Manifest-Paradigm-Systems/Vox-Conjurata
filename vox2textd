#!/usr/bin/env python3
"""vox2textd — Push-to-talk: hold Ctrl+Shift+Space → speak → release → text typed.

Hold the combo, speak, release — transcription is typed directly into the
active window (terminal, browser, anywhere) via wtype.

Key differences from v1:
  - NO keyboard grab — your keyboard works normally until you hold the combo
  - Hold-to-talk, release-to-send — not fire-once
  - Text lands in the focused app via wtype (not clipboard)

Usage:
  vox2textd                     — daemonize (background)
  vox2textd --foreground        — run in terminal (testing)
  vox2textd stop                — stop daemon
  vox2textd status              — check if running
  vox2textd --find-keys         — see key scancodes for debugging
"""

import io
import os
import signal
import struct
import subprocess
import sys
import threading
import time
import wave
from pathlib import Path

import evdev
from evdev import ecodes
import numpy as np
import pyaudio
import requests

# ── Config ────────────────────────────────────────────────────────────────
STT_URL = os.getenv("VOX_STT_URL", "http://localhost:5000/v1/audio/transcriptions")
PIDFILE = Path(os.getenv("VOX2TEXT_PIDFILE", Path.home() / ".vox2textd.pid"))

# Track ydotoold lifecycle — set by ensure_ydotoold, cleaned up on exit
_ydotoold_proc: subprocess.Popen | None = None

RATE = 16000
CHUNK = 1024
FORMAT = pyaudio.paInt16
CHANNELS = 1
SILENCE_THRESHOLD = 300
MAX_RECORD_SEC = 30

# The combo: Ctrl+Shift+Space
TRIGGER_KEYS = {
    ecodes.KEY_LEFTCTRL,
    ecodes.KEY_LEFTSHIFT,
    ecodes.KEY_SPACE,
}


# ── Helpers ───────────────────────────────────────────────────────────────

def rms(data: bytes) -> float:
    """Root-mean-square of int16 PCM — for VAD if needed."""
    count = len(data) // 2
    if count == 0:
        return 0.0
    samples = struct.unpack(f"<{count}h", data)
    return float(np.sqrt(np.mean(np.square(samples))))


def find_good_device(pa: pyaudio.PyAudio) -> int:
    """Auto-pick the best mic device.

    Prefers PipeWire virtual devices (which handle resampling) over raw
    ALSA hardware devices that may not support 16kHz directly.
    """
    # Prefer the "default" PipeWire device — it handles sample rate
    # conversion transparently so our 16kHz request just works.
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        name = info["name"]
        if name in ("default", "pipewire", "sysdefault"):
            return i

    # Fallback: match by brand keywords
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        name = info["name"]
        if "EKSA" in name or "Headset" in name or "Microphone" in name:
            return i

    # Last resort
    return pa.get_default_input_device_info()["index"]


def transcribe(pcm_data: bytes) -> str:
    """Send PCM to vox-voice STT endpoint, return text."""
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wf:
        wf.setnchannels(CHANNELS)
        wf.setsampwidth(2)
        wf.setframerate(RATE)
        wf.writeframes(pcm_data)
    wav_bytes = buf.getvalue()

    resp = requests.post(
        STT_URL,
        files={"file": ("voice.wav", wav_bytes, "audio/wav")},
        data={"model_name": "base", "language": "en"},
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json().get("text", "").strip()


def ensure_ydotoold():
    """Start ydotoold if it isn't already running.

    Returns True if ydotoold is (now) available.
    """
    global _ydotoold_proc

    # Already running and we started it
    if _ydotoold_proc is not None and _ydotoold_proc.poll() is None:
        return True

    # Check if an external ydotoold is already running (common socket path)
    sock = Path(os.getenv("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / ".ydotool_socket"
    if sock.exists():
        try:
            subprocess.run(
                ["ydotool", "type", "--", ""],
                timeout=3, capture_output=True,
            )
            if sock.exists():
                _ydotoold_proc = subprocess.Popen(["true"])  # sentinel: running but not ours
                return True
        except Exception:
            pass

    # Need to start it ourselves
    try:
        _ydotoold_proc = subprocess.Popen(
            ["ydotoold"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        time.sleep(0.3)  # give it a moment to claim the socket
        return _ydotoold_proc.poll() is None
    except FileNotFoundError:
        return False


def stop_ydotoold():
    """Kill ydotoold only if we started it."""
    global _ydotoold_proc
    if _ydotoold_proc is not None:
        cmd = _ydotoold_proc.args
        # Only kill if we started it (not a sentinel `true` or external one)
        if isinstance(cmd, list) and "ydotoold" in cmd:
            _ydotoold_proc.terminate()
            _ydotoold_proc.wait(timeout=5)
        _ydotoold_proc = None


def type_text(text: str):
    """Type text into the active window using ydotool.

    Falls back to wl-copy + notify-send if ydotool fails.
    """
    if not text:
        return
    try:
        subprocess.run(
            ["ydotool", "type", "--", text],
            timeout=10,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        # Fallback: clipboard + notification
        try:
            subprocess.run(["wl-copy"], input=text.encode(), timeout=5)
            subprocess.run(
                ["notify-send", "📝 vox2text", text],
                timeout=5,
            )
        except Exception:
            pass


# ── Recorder ──────────────────────────────────────────────────────────────

class Recorder:
    """Captures audio in a daemon thread until told to stop."""

    def __init__(self, device_index: int):
        self._device = device_index
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._pcm: bytes | None = None

    def start(self):
        """Begin recording in a background thread."""
        self._stop.clear()
        self._pcm = None
        self._thread = threading.Thread(target=self._record, daemon=True)
        self._thread.start()

    def stop(self) -> bytes | None:
        """Signal stop, wait for thread, return PCM data (or None)."""
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=5)
        return self._pcm

    def _record(self):
        """Thread target: capture audio until stop is set."""
        self._pcm = None
        pa = pyaudio.PyAudio()
        try:
            stream = pa.open(
                format=FORMAT, channels=CHANNELS, rate=RATE,
                input=True, input_device_index=self._device,
                frames_per_buffer=CHUNK,
            )
            frames = []
            for _ in range(4):  # skip mic pop
                stream.read(CHUNK, exception_on_overflow=False)

            while not self._stop.is_set():
                data = stream.read(CHUNK, exception_on_overflow=False)
                frames.append(data)

            stream.stop_stream()
            stream.close()

            if frames:
                self._pcm = b"".join(frames)
        except Exception as e:
            print(f"recording error: {e}", file=sys.stderr)
        finally:
            pa.terminate()

    @property
    def pcm(self) -> bytes | None:
        return self._pcm


# ── Keyboard ──────────────────────────────────────────────────────────────

def find_keyboard() -> evdev.InputDevice:
    """Find a suitable keyboard device.  Does NOT grab."""
    candidates = []
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        caps = dev.capabilities()
        if ecodes.EV_KEY in caps:
            keys = caps[ecodes.EV_KEY]
            if ecodes.KEY_A in keys and ecodes.KEY_LEFTCTRL in keys:
                score = 2 if "Keyboard" in dev.name else 1
                if "Mouse" in dev.name and "Keyboard" not in dev.name:
                    score = -1
                candidates.append((score, path))
        dev.close()

    if not candidates:
        raise RuntimeError("No suitable keyboard found")

    candidates.sort(key=lambda x: -x[0])
    dev = evdev.InputDevice(candidates[0][1])
    return dev


def find_keys_mode():
    """Debug: print scancodes for pressed keys."""
    dev = find_keyboard()
    try:
        print(f"Reading from {dev.path}: {dev.name}", file=sys.stderr)
        print("Press keys to see codes. Ctrl+C to exit.", file=sys.stderr)
        for event in dev.read_loop():
            if event.type == ecodes.EV_KEY:
                kev = evdev.categorize(event)
                if kev.keystate == kev.key_down:
                    name = ecodes.KEY.get(kev.scancode, f"UNKNOWN[{kev.scancode}]")
                    print(f"  {kev.scancode:3d} = {name}")
    except KeyboardInterrupt:
        pass
    finally:
        dev.close()


# ── Main loop ─────────────────────────────────────────────────────────────

def listen():
    """No-grab event loop: hold combo to record, release to transcribe+type."""
    # Ensure ydotool daemon is running for text output
    if not ensure_ydotoold():
        print("⚠️  ydotoold not available — text will go to clipboard+notification instead",
              file=sys.stderr)

    dev = find_keyboard()
    print(f"✅ vox2textd listening on {dev.path}: {dev.name}", file=sys.stderr)
    print(f"   Hold Ctrl+Shift+Space → speak → release → text typed", file=sys.stderr)
    sys.stderr.flush()

    # Resolve audio device once up front
    pa_i = pyaudio.PyAudio()
    audio_device = find_good_device(pa_i)
    pa_i.terminate()
    print(f"🎤 Mic device [{audio_device}]", file=sys.stderr)
    sys.stderr.flush()

    held: set[int] = set()
    combo_active = False
    recorder: Recorder | None = None
    record_thread: threading.Thread | None = None
    # Debounce: ignore brief re-trigger within combo (e.g., V repeating)
    last_release = 0.0

    def start_recording():
        nonlocal recorder, record_thread
        recorder = Recorder(audio_device)
        record_thread = recorder.start()
        print(f"\n🎤 [hold] Recording… release to stop", file=sys.stderr)
        sys.stderr.flush()

    def stop_recording():
        nonlocal recorder, record_thread, last_release
        if recorder is None:
            return
        pcm = recorder.stop()
        recorder = None
        record_thread = None

        if pcm and len(pcm) > 4096:
            print(f"   Transcribing…", file=sys.stderr, end="", flush=True)
            text = transcribe(pcm)
            if text:
                print(f"\r📝 {text}", file=sys.stderr)
                type_text(text)
            else:
                print(f"\r   (no speech detected)", file=sys.stderr)
        else:
            print(f"   (too short / silent)", file=sys.stderr)
        sys.stderr.flush()

    try:
        for event in dev.read_loop():
            if event.type != ecodes.EV_KEY:
                continue

            kev = evdev.categorize(event)
            keycode = kev.scancode

            if kev.keystate == kev.key_down:
                held.add(keycode)
            elif kev.keystate == kev.key_up:
                held.discard(keycode)
                last_release = time.monotonic()

            all_down = TRIGGER_KEYS.issubset(held)

            # Combo fully held → start recording
            if all_down and not combo_active and (time.monotonic() - last_release) > 0.15:
                combo_active = True
                start_recording()

            # Any trigger key released → stop recording + transcribe
            if not all_down and combo_active:
                combo_active = False
                stop_recording()

    except KeyboardInterrupt:
        pass
    finally:
        if recorder:
            recorder.stop()
        dev.close()
        stop_ydotoold()
        print("vox2textd stopped", file=sys.stderr)


# ── Daemon lifecycle ──────────────────────────────────────────────────────

def daemonize():
    """Fork into background, write PID file, start listen()."""
    pid = os.fork()
    if pid > 0:
        # First parent exits — pid is the intermediate child
        sys.exit(0)
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        # Intermediate child exits — now pid2 is the actual daemon
        sys.exit(0)
    # ── Daemon process ──
    PIDFILE.write_text(str(os.getpid()))
    with open(os.devnull, "r") as f:
        os.dup2(f.fileno(), sys.stdin.fileno())
    with open(os.devnull, "w") as f:
        os.dup2(f.fileno(), sys.stdout.fileno())
        os.dup2(f.fileno(), sys.stderr.fileno())
    listen()


def stop():
    if not PIDFILE.exists():
        print("vox2textd not running (no PID file)", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f"vox2textd (PID {pid}) stopped", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)
    except ProcessLookupError:
        print(f"vox2textd not running (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


def status():
    if not PIDFILE.exists():
        print("vox2textd: stopped", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, 0)
        print(f"vox2textd: running (PID {pid})", file=sys.stderr)
    except ProcessLookupError:
        print(f"vox2textd: stopped (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


# ── Entry ─────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "stop":
            stop()
            return
        if cmd == "status":
            status()
            return
        if cmd == "--foreground":
            listen()
            return
        if cmd == "--find-keys":
            find_keys_mode()
            return
        if cmd == "start":
            daemonize()
            return
        if cmd == "restart":
            stop()
            time.sleep(0.5)
            daemonize()
            return
    # Default: daemonize
    daemonize()


if __name__ == "__main__":
    main()
