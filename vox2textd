#!/usr/bin/env python3
"""vox2textd — Push-to-talk: hold Ctrl+Shift+Space → speak → release → popup.

Hold the combo, speak, release — a popup window appears with the transcribed
text.  Edit it, then press Enter to inject into the focused app (terminal,
browser, editor — anything).

Key differences from v1:
  - NO keyboard grab — your keyboard works normally until you hold the combo
  - Hold-to-talk → review popup → Enter-to-inject (not type-raw)
  - Text lands in the focused app via the popup (ydotool/wtype)
  - No live-typing during hold (typing while modifiers are held sends control
    characters, crashing the focused app) — text only appears on release

Popup behavior:
  - Shows transcribed text in a GTK window (always-on-top)
  - Edit if needed
  - Enter → window closes → text types into whatever app is focused
  - Escape → window closes, nothing typed

Usage:
  vox2textd                     — daemonize (background)
  vox2textd --foreground        — run in terminal (testing)
  vox2textd stop                — stop daemon
  vox2textd status              — check if running
  vox2textd --find-keys         — see key scancodes for debugging
"""

import io
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import wave
from pathlib import Path

import evdev
from evdev import ecodes
import pyaudio
import requests

# Global flag so the signal handler can stop the event loop cleanly
_running = True

# ── Config ────────────────────────────────────────────────────────────────
STT_URL = os.getenv("VOX_STT_URL", "http://localhost:5000/v1/audio/transcriptions")
PIDFILE = Path(os.getenv("VOX2TEXT_PIDFILE", Path.home() / ".vox2textd.pid"))
INJECT_MODE = os.getenv("VOX_INJECT_MODE", "direct")  # "direct" or "popup"

# Track ydotoold lifecycle — set by ensure_ydotoold, cleaned up on exit
_ydotoold_proc: subprocess.Popen | None = None

RATE = 16000
CHUNK = 1024
FORMAT = pyaudio.paInt16
CHANNELS = 1
MAX_RECORD_SEC = 30

# The combo: Ctrl+Shift+Space
TRIGGER_KEYS = {
    ecodes.KEY_LEFTCTRL,
    ecodes.KEY_LEFTSHIFT,
    ecodes.KEY_SPACE,
}


# ── Helpers ───────────────────────────────────────────────────────────────

def find_good_device(pa: pyaudio.PyAudio) -> int:
    """Auto-pick the best mic device.

    Tries, in order of preference:
      1. "default" / "sysdefault" ALSA PCM  — system default, always reliable
      2. "pipewire" virtual device          — handles resampling
      3. Named hardware devices (brand keywords)
      4. Whatever PyAudio thinks is default

    The separate passes matter because "default" (always index 17 on this
    system) is a safer choice than "pipewire" (index 16) — PipeWire's
    virtual device can intermittently reject our stream parameters when
    the PipeWire graph is in transition.
    """
    # First pass: the system default PCM
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        if info["name"] in ("default", "sysdefault"):
            return i

    # Second pass: PipeWire virtual device
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        if info["name"] == "pipewire":
            return i

    # Fallback: match by brand keywords
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        name = info["name"]
        if "EKSA" in name or "Headset" in name or "Microphone" in name:
            return i

    # Last resort
    return pa.get_default_input_device_info()["index"]


def transcribe(pcm_data: bytes) -> str:
    """Send PCM to vox-voice STT endpoint, return text."""
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wf:
        wf.setnchannels(CHANNELS)
        wf.setsampwidth(2)
        wf.setframerate(RATE)
        wf.writeframes(pcm_data)
    wav_bytes = buf.getvalue()

    resp = requests.post(
        STT_URL,
        files={"file": ("voice.wav", wav_bytes, "audio/wav")},
        data={"model_name": "base", "language": "en"},
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json().get("text", "").strip()


def ensure_ydotoold():
    """Start ydotoold if it isn't already running.

    Returns True if ydotoold is (now) available.
    """
    global _ydotoold_proc

    # Already running and we started it
    if _ydotoold_proc is not None and _ydotoold_proc.poll() is None:
        return True

    # Check if an external ydotoold is already running (common socket path)
    sock = Path(os.getenv("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / ".ydotool_socket"
    if sock.exists():
        try:
            subprocess.run(
                ["ydotool", "type", "--", ""],
                timeout=3, capture_output=True,
            )
            if sock.exists():
                _ydotoold_proc = subprocess.Popen(["true"])  # sentinel: running but not ours
                return True
        except Exception:
            pass

    # Need to start it ourselves
    try:
        _ydotoold_proc = subprocess.Popen(
            ["ydotoold"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        time.sleep(0.3)  # give it a moment to claim the socket
        return _ydotoold_proc.poll() is None
    except FileNotFoundError:
        return False


def stop_ydotoold():
    """Kill ydotoold only if we started it."""
    global _ydotoold_proc
    if _ydotoold_proc is not None:
        cmd = _ydotoold_proc.args
        # Only kill if we started it (not a sentinel `true` or external one)
        if isinstance(cmd, list) and "ydotoold" in cmd:
            _ydotoold_proc.terminate()
            _ydotoold_proc.wait(timeout=5)
        _ydotoold_proc = None


POPUP_SCRIPT = Path(__file__).resolve().parent / "vox2text-popup"


def _notify(summary: str, body: str = "", urgency: str = "low"):
    """Send a Plasma notification."""
    try:
        subprocess.run(
            ["notify-send", f"--urgency={urgency}", summary, body],
            timeout=3, stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def _inject_direct(text: str):
    """Inject text into the focused app — no popup, no stealing focus.

    Copies the text to clipboard, then sends Ctrl+V via ydotool.
    This avoids the popup-steals-focus problem entirely because
    WE NEVER OPEN A WINDOW.  The user was already focused on their
    target (terminal, browser, editor) when they held the combo,
    and that focus never moves.

    If injection fails (ydotool unavailable), falls back to a
    notification telling the user to Ctrl+V manually.
    """
    if not text:
        return

    # 1. Copy to clipboard (always — reliable fallback)
    try:
        subprocess.run(["wl-copy"], input=text.encode(), timeout=5)
    except Exception:
        _notify("📝 vox2text", f"Clipboard failed:\n{text[:120]}", "critical")
        return

    # 2. Inject via ydotool — no focus delay needed since no window opened
    if _ydotoold_alive():
        try:
            subprocess.run(
                ["ydotool", "key", "ctrl+v"],
                timeout=5, stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass

    # 3. Notification confirming injection (don't block on it)
    preview = text[:120] + ("…" if len(text) > 120 else "")
    _notify("📝 vox2text", f"Injected: {preview}")


def _ydotoold_alive() -> bool:
    """Check if the ydotoold daemon is running and responsive."""
    try:
        sock = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / ".ydotool_socket"
        if not sock.exists():
            return False
        result = subprocess.run(
            ["ydotool", "type", "--", ""],
            timeout=3, capture_output=True,
        )
        return result.returncode == 0
    except Exception:
        return False


def launch_popup(text: str):
    """Show transcribed text in a popup window for user review.

    The popup handles injection via ydotool/wtype when the user
    presses Enter.  We just launch it and return immediately.
    """
    if not text or not POPUP_SCRIPT.exists():
        return
    try:
        subprocess.Popen(
            [sys.executable, str(POPUP_SCRIPT), "--text", text],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


# ── Recorder ──────────────────────────────────────────────────────────────

class Recorder:
    """Captures audio in a daemon thread.  Supports partial reads for live
    transcription: call get_frames_since() from another thread to fetch
    audio recorded since the last checkpoint."""

    def __init__(self, device_index: int, max_sec: int = 30):
        self._device = device_index
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._lock = threading.Lock()
        self._frames: list[bytes] = []
        self._max_chunks = int(max_sec * RATE / CHUNK)

    def start(self):
        """Begin recording in a background thread."""
        self._stop.clear()
        self._frames = []
        self._thread = threading.Thread(target=self._record, daemon=True)
        self._thread.start()

    def stop(self):
        """Signal stop, wait for thread to finish."""
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=5)

    def get_frames_since(self, index: int) -> tuple[list[bytes], int]:
        """Return (new_frames, total_frame_count) since the given index."""
        with self._lock:
            return self._frames[index:], len(self._frames)

    def get_and_trim(self, index: int) -> tuple[list[bytes], int]:
        """Return frames since *index* and discard everything before it.

        This bounds memory growth during a long hold: old frames are freed
        atomically with the read so no frames are lost to a race.
        """
        with self._lock:
            new_frames = self._frames[index:]
            self._frames = list(new_frames)
            return new_frames, len(self._frames)

    def _record(self):
        """Thread target: capture audio until stop is set.

        Tries the configured device first.  If it fails to open, falls
        back to scanning all input-capable devices for one that works
        with our format (16 kHz / 1 channel / paInt16).  This handles
        the case where PipeWire's virtual device temporarily refuses a
        stream while the graph reconfigures.
        """
        pa = pyaudio.PyAudio()
        stream = None
        try:
            # Build candidate list: preferred device first, then every
            # other input-capable device as a fallback.
            candidates = [self._device]
            candidates.extend(
                i for i in range(pa.get_device_count())
                if i != self._device
                and pa.get_device_info_by_index(i)["maxInputChannels"] > 0
            )

            for dev in candidates:
                try:
                    stream = pa.open(
                        format=FORMAT, channels=CHANNELS, rate=RATE,
                        input=True, input_device_index=dev,
                        frames_per_buffer=CHUNK,
                    )
                    if dev != self._device:
                        print(f"   mic fallback: device {self._device} → {dev}", file=sys.stderr)
                        self._device = dev
                    break
                except Exception:
                    continue

            if stream is None:
                print("recording error: no working input device found", file=sys.stderr)
                return

            for _ in range(8):  # skip mic pop
                stream.read(CHUNK, exception_on_overflow=False)

            chunks = 0
            while not self._stop.is_set() and chunks < self._max_chunks:
                data = stream.read(CHUNK, exception_on_overflow=False)
                with self._lock:
                    self._frames.append(data)
                chunks += 1

            stream.stop_stream()
            stream.close()
        except Exception as e:
            print(f"recording error: {e}", file=sys.stderr)
        finally:
            pa.terminate()


# ── Keyboard ──────────────────────────────────────────────────────────────

def find_keyboard() -> evdev.InputDevice:
    """Find a suitable keyboard device.  Does NOT grab."""
    candidates = []
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        caps = dev.capabilities()
        if ecodes.EV_KEY in caps:
            keys = caps[ecodes.EV_KEY]
            if ecodes.KEY_A in keys and ecodes.KEY_LEFTCTRL in keys:
                score = 2 if "Keyboard" in dev.name else 1
                if "Mouse" in dev.name and "Keyboard" not in dev.name:
                    score = -1
                candidates.append((score, path))
        dev.close()

    if not candidates:
        raise RuntimeError("No suitable keyboard found")

    candidates.sort(key=lambda x: -x[0])
    dev = evdev.InputDevice(candidates[0][1])
    return dev


def find_keys_mode():
    """Debug: print scancodes for pressed keys."""
    dev = find_keyboard()
    try:
        print(f"Reading from {dev.path}: {dev.name}", file=sys.stderr)
        print("Press keys to see codes. Ctrl+C to exit.", file=sys.stderr)
        for event in dev.read_loop():
            if event.type == ecodes.EV_KEY:
                kev = evdev.categorize(event)
                if kev.keystate == kev.key_down:
                    name = ecodes.KEY.get(kev.scancode, f"UNKNOWN[{kev.scancode}]")
                    print(f"  {kev.scancode:3d} = {name}")
    except KeyboardInterrupt:
        pass
    finally:
        dev.close()


# ── Main loop ─────────────────────────────────────────────────────────────

def _sigterm_handler(signum, frame):
    """Clean shutdown on SIGTERM — raises KeyboardInterrupt so the finally
    block in listen() runs (evdev close, ydotoold stop, etc.)."""
    global _running
    _running = False
    raise KeyboardInterrupt()


def listen():
    """No-grab event loop: hold combo to record, release to transcribe+type."""
    signal.signal(signal.SIGTERM, _sigterm_handler)
    # Ensure ydotool daemon is running for text output
    if not ensure_ydotoold():
        print("⚠️  ydotoold not available — text will go to clipboard+notification instead",
              file=sys.stderr)

    dev = find_keyboard()
    print(f"✅ vox2textd listening on {dev.path}: {dev.name}", file=sys.stderr)
    print(f"   Hold Ctrl+Shift+Space → speak → release → popup → Enter to type", file=sys.stderr)
    sys.stderr.flush()

    # Resolve audio device once up front
    pa_i = pyaudio.PyAudio()
    audio_device = find_good_device(pa_i)
    pa_i.terminate()
    print(f"🎤 Mic device [{audio_device}]", file=sys.stderr)
    sys.stderr.flush()

    held: set[int] = set()
    combo_active = False
    recorder: Recorder | None = None
    last_release = 0.0  # debounce for rapid re-trigger
    _transcribe_lock = threading.Lock()

    def do_transcribe():
        """Called after combo released: record → transcribe → launch popup.

        Guarded by a threading.Lock so rapid re-triggers don't race on the
        `recorder` variable.  If a transcription is already in flight the
        second call is dropped (the recording is still stopped by the caller
        setting combo_active=False — no audio is lost, only the duplicate
        work).
        """
        nonlocal recorder
        if not _transcribe_lock.acquire(blocking=False):
            return
        try:
            if not recorder:
                return
            recorder.stop()
            frames, total = recorder.get_frames_since(0)
            pcm = b"".join(frames)
            recorder = None

            if len(pcm) < 4096:
                return

            text = ""
            try:
                text = transcribe(pcm)
            except Exception as e:
                print(f"   transcribe error: {e}", file=sys.stderr)
                return

            if text.strip():
                print(f"   → {text}", file=sys.stderr)
                if INJECT_MODE == "direct":
                    _inject_direct(text.strip())
                else:
                    launch_popup(text.strip())
        finally:
            _transcribe_lock.release()

    try:
        for event in dev.read_loop():
            if event.type != ecodes.EV_KEY:
                continue

            kev = evdev.categorize(event)
            keycode = kev.scancode

            if kev.keystate == kev.key_down:
                held.add(keycode)
            elif kev.keystate == kev.key_up:
                held.discard(keycode)
                last_release = time.monotonic()

            all_down = TRIGGER_KEYS.issubset(held)

            # Combo fully held → start recording
            if all_down and not combo_active and (time.monotonic() - last_release) > 0.15:
                combo_active = True
                recorder = Recorder(audio_device, max_sec=MAX_RECORD_SEC)
                recorder.start()
                print(f"\n🎤 [hold] Speak… release to stop", file=sys.stderr)
                sys.stderr.flush()

            # Any trigger key released → stop, transcribe, launch popup
            if not all_down and combo_active:
                combo_active = False
                # do_transcribe handles stopping + transcribing + popup
                threading.Thread(target=do_transcribe, daemon=True).start()
                print(file=sys.stderr)
                sys.stderr.flush()

    except KeyboardInterrupt:
        pass
    finally:
        if recorder:
            recorder.stop()
        dev.close()
        stop_ydotoold()
        print("vox2textd stopped", file=sys.stderr)


# ── Daemon lifecycle ──────────────────────────────────────────────────────

def daemonize():
    """Fork into background, write PID file, start listen()."""
    pid = os.fork()
    if pid > 0:
        # First parent exits — pid is the intermediate child
        sys.exit(0)
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        # Intermediate child exits — now pid2 is the actual daemon
        sys.exit(0)
    # ── Daemon process ──
    PIDFILE.write_text(str(os.getpid()))
    with open(os.devnull, "r") as f:
        os.dup2(f.fileno(), sys.stdin.fileno())
    with open(os.devnull, "w") as f:
        os.dup2(f.fileno(), sys.stdout.fileno())
        os.dup2(f.fileno(), sys.stderr.fileno())
    listen()


def stop():
    if not PIDFILE.exists():
        print("vox2textd not running (no PID file)", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f"vox2textd (PID {pid}) stopped", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)
    except ProcessLookupError:
        print(f"vox2textd not running (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


def status():
    if not PIDFILE.exists():
        print("vox2textd: stopped", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, 0)
        print(f"vox2textd: running (PID {pid})", file=sys.stderr)
    except ProcessLookupError:
        print(f"vox2textd: stopped (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


# ── Entry ─────────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "stop":
            stop()
            return
        if cmd == "status":
            status()
            return
        if cmd == "--foreground":
            listen()
            return
        if cmd == "--find-keys":
            find_keys_mode()
            return
        if cmd == "start":
            daemonize()
            return
        if cmd == "restart":
            stop()
            time.sleep(0.5)
            daemonize()
            return
    # Default: daemonize
    daemonize()


if __name__ == "__main__":
    main()
