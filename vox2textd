#!/usr/bin/env python3
"""vox2textd — background daemon: listens for Ctrl+Shift+V, records, transcribes.

Runs as a user service. Press Ctrl+Shift+V anywhere → speak → text lands in
~/.vox_transcript + notification + clipboard.

Use --foreground to run interactively (for testing).
Use --find-keys to see which key events your keyboard produces.
"""

import os
import signal
import subprocess
import sys
import time
from pathlib import Path

import evdev
from evdev import ecodes

VOX2TEXT = os.getenv("VOX2TEXT", "/var/home/EvokeStudio/vox-conjurata/vox2text")
PIDFILE = Path(os.getenv("VOX2TEXT_PIDFILE", Path.home() / ".vox2textd.pid"))

# The combo we're listening for
TRIGGER_KEYS = {
    ecodes.KEY_LEFTCTRL,
    ecodes.KEY_LEFTSHIFT,
    ecodes.KEY_V,
}


def find_keyboard() -> evdev.InputDevice:
    """Find the best keyboard device — prefer a real keyboard over mouse/mice."""
    candidates = []
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        caps = dev.capabilities()
        # A keyboard should have EV_KEY and some KEY_* codes
        if ecodes.EV_KEY in caps:
            key_codes = caps[ecodes.EV_KEY]
            # Real keyboards have letter keys
            if ecodes.KEY_A in key_codes and ecodes.KEY_LEFTCTRL in key_codes:
                # Prefer devices with "Keyboard" in name
                score = 2 if "Keyboard" in dev.name else 1
                # Avoid mouse-only devices with keyboard passthrough
                if "Mouse" in dev.name and "Keyboard" not in dev.name:
                    score = -1
                candidates.append((score, dev))
            else:
                dev.close()
        else:
            dev.close()

    if not candidates:
        raise RuntimeError("No suitable keyboard found")

    # Sort by score desc, pick the first
    candidates.sort(key=lambda x: -x[0])
    dev = candidates[0][1]
    dev.grab()
    return dev


def listen(foreground: bool = False):
    """Main loop: listen for trigger combo, fire vox2text."""
    dev = find_keyboard()
    print(f"✅ vox2textd listening on {dev.path}: {dev.name}", file=sys.stderr)
    print(f"   Press Ctrl+Shift+V to transcribe voice → terminal", file=sys.stderr)
    sys.stderr.flush()

    held = set()
    fired = False  # debounce: don't fire repeatedly while held

    try:
        for event in dev.read_loop():
            if event.type != ecodes.EV_KEY:
                continue

            kev = evdev.categorize(event)
            keycode = kev.scancode

            if kev.keystate == kev.key_down:
                held.add(keycode)
            elif kev.keystate == kev.key_up:
                held.discard(keycode)
                fired = False  # reset debounce on release

            # Check if all trigger keys are held
            if TRIGGER_KEYS.issubset(held) and not fired:
                fired = True
                sys.stderr.write("\n🎤 Triggered!\n")
                sys.stderr.flush()
                # Fire vox2text (non-blocking)
                subprocess.Popen(
                    [VOX2TEXT],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    stdin=subprocess.DEVNULL,
                )
                # Small debounce delay
                time.sleep(0.3)

    except KeyboardInterrupt:
        pass
    finally:
        dev.ungrab()
        dev.close()
        print("vox2textd stopped", file=sys.stderr)


def daemonize():
    """Fork into background."""
    pid = os.fork()
    if pid > 0:
        # Parent exits
        PIDFILE.write_text(str(pid))
        print(f"vox2textd started (PID {pid})", file=sys.stderr)
        sys.exit(0)
    # Child continues
    os.setsid()
    # Second fork to fully detach
    pid2 = os.fork()
    if pid2 > 0:
        sys.exit(0)
    # Close stdio
    with open(os.devnull, "r") as f:
        os.dup2(f.fileno(), sys.stdin.fileno())
    with open(os.devnull, "w") as f:
        os.dup2(f.fileno(), sys.stdout.fileno())
        os.dup2(f.fileno(), sys.stderr.fileno())
    listen(foreground=False)


def stop():
    """Stop the daemon."""
    if not PIDFILE.exists():
        print("vox2textd not running (no PID file)", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f"vox2textd (PID {pid}) stopped", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)
    except ProcessLookupError:
        print(f"vox2textd not running (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


def find_keys_mode():
    """Helper: press keys and see what scancodes they produce."""
    dev = find_keyboard()
    print(f"Reading from {dev.path}: {dev.name}", file=sys.stderr)
    print("Press keys to see their codes. Ctrl+C to exit.", file=sys.stderr)
    try:
        for event in dev.read_loop():
            if event.type == ecodes.EV_KEY:
                kev = evdev.categorize(event)
                if kev.keystate == kev.key_down:
                    name = ecodes.KEY.get(kev.scancode, f"UNKNOWN[{kev.scancode}]")
                    print(f"  {kev.scancode:3d} = {name}")
    except KeyboardInterrupt:
        pass
    finally:
        dev.close()


def status():
    """Check if daemon is running."""
    if not PIDFILE.exists():
        print("vox2textd: stopped (no PID file)", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, 0)
        print(f"vox2textd: running (PID {pid})", file=sys.stderr)
    except ProcessLookupError:
        print(f"vox2textd: stopped (stale PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)


def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "stop":
            stop()
            return
        if cmd == "status":
            status()
            return
        if cmd == "--foreground":
            listen(foreground=True)
            return
        if cmd == "--find-keys":
            find_keys_mode()
            return
        if cmd == "start":
            daemonize()
            return
        if cmd == "restart":
            stop()
            time.sleep(0.5)
            daemonize()
            return

    # Default: daemonize
    daemonize()


if __name__ == "__main__":
    main()
