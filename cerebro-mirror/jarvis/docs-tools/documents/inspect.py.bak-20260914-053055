# Ensure PyPDF2 is installed in your environment using: pip install PyPDF2
import PyPDF2
import pdfplumber


def inspect_pdf(pdf_path):
    # Initialize the result dictionary
    result = {
        'form_fields': [],
        'blank_regions': []
    }

    # Use PyPDF2 to detect form fields
    with open(pdf_path, 'rb') as file:
        reader = PyPDF2.PdfReader(file)
        if '/AcroForm' in reader.trailer.get('/Root', {}):
            fields = reader.get_fields()
            for field in fields:
                result['form_fields'].append(field['/T'])

    # Use pdfplumber to detect blank regions
    with pdfplumber.open(pdf_path) as pdf:
        for page_number, page in enumerate(pdf.pages, start=1):
            text = page.extract_text()
            if not text:
                result['blank_regions'].append(page_number)  # Page numbers are 1-based

    return result
