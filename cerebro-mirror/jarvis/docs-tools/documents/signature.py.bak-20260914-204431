import os
from pypdf import PdfReader, PdfWriter, AnnotationBuilder

def add_signature_widget(pdf_path, out_path, field_name="Signature1", position=(100, 100), size=(200, 100)):
    # Open the existing PDF in binary mode
    with open(pdf_path, "rb") as in_file:
        reader = PdfReader(in_file)
        writer = PdfWriter()

        # Copy all pages from the reader to the writer
        for page in reader.pages:
            writer.add_page(page)

        # Create a signature annotation
        signature_annotation = AnnotationBuilder.free_text(
            rect=(position[0], position[1], position[0] + size[0], position[1] + size[1]),
            text=field_name,
            font_size=12,
            font="helv",
            color=(0, 0, 0),
            border_color=(0, 0, 0),
            border_width=1
        )

        # Add the signature annotation to the first page
        writer.add_annotation(0, signature_annotation)

        # Write the updated PDF to a new file
        os.makedirs(os.path.dirname(out_path) or ".", exist_ok=True)
        with open(out_path, "wb") as out_file:
            writer.write(out_file)
    return out_path
