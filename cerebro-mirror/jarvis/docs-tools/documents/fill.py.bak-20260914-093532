import fitz  # PyMuPDF

def fill_form(pdf_path, field_values):
    # Open the existing PDF
    doc = fitz.open(pdf_path)

    # Iterate through each field in the document
    for field in doc.annots():
        if field.field_name in field_values:
            field.set_field_value(field_values[field.field_name])

    # Write the updated PDF to a new file
    output_path = 'filled_' + pdf_path
    doc.save(output_path)
    doc.close()
