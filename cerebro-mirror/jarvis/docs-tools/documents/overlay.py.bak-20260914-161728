import fitz  # PyMuPDF

def overlay_text(pdf_path, text, position, fontname="helv", fontsize=12, color=(0, 0, 0)):
    # Open the existing PDF
    doc = fitz.open(pdf_path)

    # Ensure position is a valid tuple
    if not isinstance(position, tuple) or len(position) != 2:
        raise ValueError("Position must be a tuple of two numbers (x, y)")

    # Add text to the first page
    page = doc.load_page(0)  # Assuming we want to overlay text on the first page
    page.insert_text(position, text, fontsize=fontsize, fontname=fontname, color=color)

    # Write the updated PDF to a new file
    output_path = 'overlayed_' + pdf_path
    doc.save(output_path)
    doc.close()
    return output_path
