import PyPDF2
import pdfplumber

def inspect_pdf(pdf_path):
    # Initialize the result dictionary
    result = {
        'form_fields': [],
        'blank_regions': []
    }

    # Use PyPDF2 to detect form fields
    with open(pdf_path, 'rb') as file:
        reader = PyPDF2.PdfReader(file)
        if reader.acro_form:
            fields = reader.acro_form.get_fields()
            result['form_fields'] = [field.get('/T') for field in fields]

    # Use pdfplumber to detect blank regions
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            text = page.extract_text()
            if not text:
                result['blank_regions'].append(page.page_number + 1)  # Page numbers are 1-based

    return result
