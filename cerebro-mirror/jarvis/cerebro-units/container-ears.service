# container-ears.service  (cerebro)
# whisper.cpp HIP large-v3-q5_0 STT server, port 8085. Binary built in
# whisper-build container (src/build/bin), mounted read-only.
[Unit]
Description=whisper.cpp ears (STT), port 8085
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name ears \
    --network vox-net \
    -p 8085:8085 \
    --device /dev/kfd:/dev/kfd \
    --device /dev/dri/renderD128:/dev/dri/renderD128 \
    --security-opt label=disable \
    -v /var/home/admin/build-whisper/src/build/bin:/src/build/bin:ro \
    -v /var/home/admin/models:/models:ro \
    --entrypoint /src/build/bin/whisper-server \
    ghcr.io/ggml-org/llama.cpp:server-rocm \
    -m /models/whisper/ggml-large-v3-q5_0.bin \
    --host 0.0.0.0 --port 8085 -t 8
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
