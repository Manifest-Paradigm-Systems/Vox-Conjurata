# container-coder.service  (cerebro)
# Qwen2.5-Coder-32B-Instruct Q5_K_M coding lane, port 8082.
# Sizing: 32k ctx, q8_0 KV, --parallel 2.
[Unit]
Description=Qwen-Coder-32B coding lane (coder), port 8082
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name coder \
    --network vox-net \
    -p 8082:8082 \
    --device /dev/kfd:/dev/kfd \
    --device /dev/dri:/dev/dri \
    --security-opt label=disable \
    -e HIP_VISIBLE_DEVICES=0 \
    -e ROCR_VISIBLE_DEVICES=0 \
    -v /var/home/admin/models:/models:ro \
    ghcr.io/ggml-org/llama.cpp:server-rocm \
    -m /models/Qwen2.5-Coder-32B-Instruct-Q5_K_M/Qwen2.5-Coder-32B-Instruct-Q5_K_M.gguf \
    -a coder --jinja --host 0.0.0.0 --port 8082 \
    -c 65536 --parallel 2 \
    --cache-type-k q8_0 --cache-type-v q8_0
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
