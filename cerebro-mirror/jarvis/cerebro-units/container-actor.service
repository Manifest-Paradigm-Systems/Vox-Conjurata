# container-actor.service  (cerebro)
# Sao10K Kunou-14B Q4_K_M voice/prosody actor (voice-coach), port 8083.
# Sizing: 16k ctx, q8_0 KV, --parallel 2.
[Unit]
Description=Kunou-14B voice actor (actor), port 8083
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name actor \
    --network vox-net \
    -p 8083:8083 \
    --device /dev/kfd:/dev/kfd \
    --device /dev/dri:/dev/dri \
    --security-opt label=disable \
    -e HIP_VISIBLE_DEVICES=0 \
    -e ROCR_VISIBLE_DEVICES=0 \
    -v /var/home/admin/models:/models:ro \
    ghcr.io/ggml-org/llama.cpp:server-rocm \
    -m /models/Sao10K-14B-Kunou/14B-Qwen2.5-Kunou-v1.Q4_K_M.gguf \
    -a actor --jinja --host 0.0.0.0 --port 8083 \
    -c 49152 --parallel 6 \
    --cache-type-k q8_0 --cache-type-v q8_0
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
