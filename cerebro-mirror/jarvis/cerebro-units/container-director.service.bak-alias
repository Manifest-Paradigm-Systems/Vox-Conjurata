# container-director.service  (cerebro)
# DeepSeek-R1-Distill-Qwen-32B Q5_K_M dramaturgy director, port 8081.
# Sizing: 64k ctx, q8_0 KV, --parallel 2. House pattern (vox-* on vox-net).
[Unit]
Description=R1-Distill-32B dramaturgy director (director), port 8081
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Restart=on-failure
TimeoutStopSec=70
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=split \
    --rm \
    --sdnotify=conmon \
    -d \
    --replace \
    --name director \
    --network vox-net \
    -p 8081:8081 \
    --device /dev/kfd:/dev/kfd \
    --device /dev/dri:/dev/dri \
    --security-opt label=disable \
    -e HIP_VISIBLE_DEVICES=0 \
    -e ROCR_VISIBLE_DEVICES=0 \
    -v /var/home/admin/models:/models:ro \
    ghcr.io/ggml-org/llama.cpp:server-rocm \
    -m /models/DeepSeek-R1-Distill-Qwen-32B-Q5_K_M/DeepSeek-R1-Distill-Qwen-32B-Q5_K_M.gguf \
    --jinja --host 0.0.0.0 --port 8081 \
    -c 131072 --parallel 2 \
    --cache-type-k q8_0 --cache-type-v q8_0
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=multi-user.target
