#!/usr/bin/env python3
"""vox2text-popup — Show transcribed text, inject into focused app on Enter.

Called by vox2textd (the hold-to-talk daemon) via:
    vox2text-popup --text "what you said"

Flow:
  1. Press Enter → copies text to clipboard, auto-pastes via Ctrl+V
  2. On success: short "Pasted!" notification, clipboard restored
  3. On failure: notification shows text — press Ctrl+V to paste manually
"""

import argparse
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk

WINDOW_TITLE = "🎤 vox2text"
INJECT_DELAY = 0.5  # seconds after window close to let focus settle (KDE/Wayland)
INJECT_RETRIES = 3
INJECT_RETRY_INTERVAL = 0.15

COLOR_BG = "#2e3440"
COLOR_FG = "#eceff4"
COLOR_GREEN = "#a3be8c"
COLOR_RED = "#bf616a"
COLOR_BORDER = "#4c566a"
COLOR_TEXT_BG = "#3b4252"


class InjectPopup(Gtk.Window):
    def __init__(self, initial_text: str):
        super().__init__(title=WINDOW_TITLE)
        self.set_default_size(520, 180)
        self.set_resizable(True)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_decorated(True)
        self.set_border_width(0)

        self._result_text: str | None = None

        # ── CSS ────────────────────────────────────────────────────────
        css = f"""
        window {{ background: {COLOR_BG}; }}
        label {{ color: {COLOR_FG}; }}
        .hint-label {{ font-size: 13px; color: #d8dee9; }}
        .text-view {{ font-size: 15px; font-family: sans-serif;
                      background: {COLOR_TEXT_BG};
                      color: {COLOR_FG}; border-radius: 6px;
                      padding: 10px; }}
        .btn-type {{ background: {COLOR_GREEN}; color: {COLOR_BG};
                     font-weight: bold; border-radius: 6px;
                     padding: 8px 24px; }}
        .btn-cancel {{ background: {COLOR_RED}; color: {COLOR_FG};
                       border-radius: 6px; padding: 8px 16px; }}
        """
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        # ── Layout ─────────────────────────────────────────────────────
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        vbox.set_margin_top(16)
        vbox.set_margin_bottom(16)
        vbox.set_margin_start(16)
        vbox.set_margin_end(16)
        self.add(vbox)

        # Header
        hdr = Gtk.Box(spacing=8)
        icon = Gtk.Label()
        icon.set_markup("<span size='x-large'>🎤</span>")
        lbl = Gtk.Label(label="Edit text — Enter to paste into focused app")
        lbl.get_style_context().add_class("hint-label")
        hdr.pack_start(icon, False, False, 0)
        hdr.pack_start(lbl, False, False, 0)
        vbox.pack_start(hdr, False, False, 0)

        # Text area
        self.text_view = Gtk.TextView()
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_editable(True)
        self.text_view.set_cursor_visible(True)
        self.text_view.get_style_context().add_class("text-view")
        self.text_buffer = self.text_view.get_buffer()
        self.text_buffer.set_text(initial_text)

        # Auto-select all text for easy replacement
        self.text_buffer.select_range(
            self.text_buffer.get_start_iter(),
            self.text_buffer.get_end_iter(),
        )

        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        frame.add(self.text_view)
        self.text_view.set_size_request(-1, 70)
        vbox.pack_start(frame, True, True, 0)

        # Buttons
        btn_row = Gtk.Box(spacing=10)
        btn_row.set_halign(Gtk.Align.CENTER)

        self.type_btn = Gtk.Button(label="⌨️  Paste  (Enter)")
        self.type_btn.get_style_context().add_class("btn-type")
        self.type_btn.connect("clicked", self.on_type)

        self.cancel_btn = Gtk.Button(label="✕  Cancel  (Esc)")
        self.cancel_btn.get_style_context().add_class("btn-cancel")
        self.cancel_btn.connect("clicked", self.on_cancel)

        btn_row.pack_start(self.type_btn, False, False, 0)
        btn_row.pack_start(self.cancel_btn, False, False, 0)
        vbox.pack_start(btn_row, False, False, 0)

        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        GLib.idle_add(self.text_view.grab_focus)

    def get_text(self) -> str:
        buf = self.text_buffer
        return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True).strip()

    def on_type(self, _btn=None):
        text = self.get_text()
        if not text:
            return
        self._result_text = text
        # Destroy window so KWin refocuses the previous app (minimize alone
        # doesn't transfer focus on KDE/Wayland, leaving ydotool keystrokes
        # aimed at a ghost window).
        self.destroy()
        Gdk.flush()
        # Gtk.main_quit is connected to the "destroy" signal above

    def on_cancel(self, _btn=None):
        self._result_text = None
        Gtk.main_quit()

    def on_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape:
            self.on_cancel()
        elif event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if not (event.state & Gdk.ModifierType.SHIFT_MASK):
                self.on_type()
            else:
                return False
        return False


def _ydotoold_alive() -> bool:
    """Check if the ydotoold daemon is running and responsive.

    Tests the ydotool socket directly rather than relying on PID state,
    since the socket is the ground truth for whether key injection works.
    """
    try:
        sock = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / ".ydotool_socket"
        if not sock.exists():
            return False
        result = subprocess.run(
            ["ydotool", "type", "--", ""],
            timeout=3, capture_output=True,
        )
        return result.returncode == 0
    except Exception:
        return False


def do_inject(text: str):
    """Copy to clipboard, auto-paste via ydotool with retry, then notify.

    Strategy:
      1. wl-copy — always succeeds or we show the text in a notification.
      2. ydotool key ctrl+v — retries a few times with a small gap so that
         KWin has time to refocus the previous app after the popup closes.
      3. Fallback — notification telling the user to press Ctrl+V manually.
    """
    if not text:
        return

    # Copy our text to clipboard (always — reliable fallback)
    try:
        subprocess.run(["wl-copy"], input=text.encode(), timeout=5)
    except Exception:
        try:
            subprocess.run(
                ["notify-send", "--urgency=critical",
                 "📝 vox2text", f"Error copying text:\n{text[:80]}"],
                timeout=3,
            )
        except Exception:
            pass
        return

    # Wait for focus to settle after popup window is destroyed
    time.sleep(INJECT_DELAY)

    # Auto-paste with retries — the first attempt may land before KWin has
    # fully refocused the previous app after the popup close.
    if _ydotoold_alive():
        for attempt in range(INJECT_RETRIES):
            try:
                subprocess.run(
                    ["ydotool", "key", "ctrl+v"],
                    timeout=5, stderr=subprocess.DEVNULL,
                )
                # Success — notify and return
                try:
                    subprocess.run(
                        ["notify-send", "--urgency=low",
                         "📝 vox2text", "Pasted! (text in clipboard)"],
                        timeout=3,
                    )
                except Exception:
                    pass
                return
            except Exception:
                if attempt < INJECT_RETRIES - 1:
                    time.sleep(INJECT_RETRY_INTERVAL)
                continue

    # Auto-paste unavailable or all retries failed — notification fallback
    preview = text[:100] + ("…" if len(text) > 100 else "")
    try:
        subprocess.run(
            ["notify-send", "--urgency=normal",
             "📝 vox2text",
             f"Press Ctrl+V to paste:\n{preview}"],
            timeout=3,
        )
    except Exception:
        pass


def main():
    parser = argparse.ArgumentParser(
        description="vox2text-popup — show text, inject into focused app on Enter",
    )
    parser.add_argument("--text", help="Text to pre-fill in the popup")
    parser.add_argument("--test", action="store_true", help="Check tools")
    args = parser.parse_args()

    if args.test:
        _test_mode()
        return

    text = args.text or ""
    if not text.strip():
        return

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    win = InjectPopup(text)
    win.show_all()
    Gtk.main()

    # Window minimized — now inject
    injection_text = win._result_text
    if injection_text:
        do_inject(injection_text)


def _test_mode():
    print("── vox2text-popup test ──")
    for cmd in ("ydotool", "wtype", "wl-paste", "wl-copy", "notify-send"):
        path = shutil.which(cmd)
        print(f"  {cmd}: {'✅ ' + path if path else '❌ not found'}")
    print()
    print("To use: vox2text-popup --text \"hello world\"")


if __name__ == "__main__":
    main()
