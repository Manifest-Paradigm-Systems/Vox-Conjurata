#!/usr/bin/env python3
"""
claude-speak — Watch Claude Code's session transcript and speak bullet points
in the C-3PO voice via vox-audio-core.

Usage:
  claude-speak start          — daemonize (background watcher)
  claude-speak stop           — stop daemon
  claude-speak <text>         — speak text once (foreground)
  claude-speak --last         — speak bullet points from last assistant response
  claude-speak status         — check if running
"""

import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

# ── Config ──
VOX_AUDIO_URL = os.getenv("VOX_AUDIO_URL", "http://localhost:8004")
PROJECT_DIR = Path(os.getenv("CLAUDE_PROJECT_DIR", Path.home() / ".claude/projects"))
PIDFILE = Path(os.getenv("CLAUDE_SPEAK_PIDFILE", Path.home() / ".claude-speak.pid"))
NPC_ID = "c3po"

# Serialise audio playback so multiple requests never overlap
_speak_lock = threading.Lock()

# DSP presets for C-3PO voice
DSP_C3PO = {
    "pitch_shift": 0,
    "highpass_hz": 100,
    "chorus_depth": 0.05,
    "reverb_size": 0.02,
    "distortion_db": 0,
}

WATCH_INTERVAL = 0.5  # seconds between poll


def speak_text(text: str):
    """Send text to vox-audio-core for C-3PO voice synthesis and play it.

    Serialised via _speak_lock so concurrent calls queue up rather than
    producing overlapping audio.
    """
    import requests

    if not text.strip():
        return

    with _speak_lock:
        print(f"🔊 C-3PO: {text[:80]}…", file=sys.stderr)

        try:
            resp = requests.post(
                f"{VOX_AUDIO_URL}/generate",
                json={
                    "npc_id": NPC_ID,
                    "dialogue_text": text.strip(),
                    "dsp_presets": DSP_C3PO,
                    "control_instruction": None,
                },
                timeout=120,
            )
            resp.raise_for_status()

            # Save to temp file and play
            wav_path = Path("/tmp/claude-speak.wav")
            wav_path.write_bytes(resp.content)
            subprocess.run(
                ["pw-play", str(wav_path)],
                timeout=60, stderr=subprocess.DEVNULL,
            )
        except Exception as e:
            print(f"  ⚠️ speak error: {e}", file=sys.stderr)
            _fallback_espeak(text)


def _fallback_espeak(text: str):
    """Fallback TTS via espeak-ng with C-3PO approximation."""
    try:
        subprocess.run(
            ["espeak-ng", "-v", "en-gb-x-rp", "-p", "80", "-s", "135", text],
            timeout=10, stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def _clean_line(text: str) -> str:
    """Strip markdown and heavy technical noise from a line of text."""
    import re
    text = text.replace("**", "").replace("__", "")
    text = re.sub(r"`[^`]+`", "", text)           # remove inline code
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)  # [text](url) → text
    text = re.sub(r"\([^)]*\.[a-zA-Z]{2,4}(:\d+)?\)", "", text)  # (file.ext) or (file.ext:123)
    text = re.sub(r"[\w\-]+/[\w\-/.]+\.[a-zA-Z]{2,4}", "", text)  # path/file.ext
    text = re.sub(r"\s+", " ", text).strip()
    return text


def _is_noise(line: str) -> bool:
    """True if a line is mostly file paths, code, or symbols."""
    if not line:
        return True
    # Lines that are >40% special chars are noise
    special = sum(1 for c in line if not c.isalnum() and c not in " ,.-'")
    if len(line) > 0 and special / len(line) > 0.4:
        return True
    # Check if it's mostly a path or filename
    if "/" in line and "." in line:
        return True
    return False


def summarize_bullets(text: str) -> list[str]:
    """Extract individual bullet points from markdown text.

    For bullet lists: returns each bullet as a clean spoken sentence.
    For prose: returns the first 1-2 sentences.
    """
    import re

    results = []
    for line in text.split("\n"):
        stripped = line.strip()
        if stripped.startswith("- ") or stripped.startswith("* "):
            content = stripped[2:]
            cleaned = _clean_line(content)
            if cleaned and not _is_noise(cleaned) and len(cleaned) > 10:
                results.append(cleaned)

    # Bullet count cap: don't drone on
    if len(results) > 6:
        results = results[:6]

    if results:
        return results

    # Prose fallback: first 1-2 sentences
    sentences = re.split(r'(?<=[.!?])\s+', text.strip())
    for s in sentences:
        cleaned = _clean_line(s)
        if cleaned and not _is_noise(cleaned) and len(cleaned) > 15:
            results.append(cleaned)
            if len(results) >= 2:
                break

    return results


def find_current_session() -> Path | None:
    """Find the most recent session transcript file."""
    if not PROJECT_DIR.exists():
        return None

    # Walk project subdirectories for the newest .jsonl
    sessions = []
    for project_dir in PROJECT_DIR.iterdir():
        if project_dir.is_dir():
            for f in project_dir.glob("*.jsonl"):
                sessions.append(f)

    if not sessions:
        return None

    return max(sessions, key=lambda f: f.stat().st_mtime)


def _seed_seen_ids(session_file: Path, seen_ids: set[str]):
    """Pre-populate seen_ids with assistant message IDs already in the file."""
    try:
        with open(session_file) as f:
            for line in f:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if entry.get("type") == "assistant":
                    msg_id = entry.get("message", {}).get("id", "")
                    if msg_id:
                        seen_ids.add(msg_id)
    except (OSError, IOError):
        pass


def watch_session():
    """Watch session transcript for new assistant responses.

    Tracks a file-position bookmark (last_byte) so every byte is read exactly
    once, combined with UUID dedup so nothing is spoken twice even if the file
    is truncated or rotated.
    """
    session_file = find_current_session()
    if not session_file:
        print("⚠️  No Claude Code session found", file=sys.stderr)
        return

    print(f"👁️  Watching {session_file.name}", file=sys.stderr)

    seen_ids: set[str] = set()
    # Capture file position BEFORE catch-up so content written during the
    # catch-up is not permanently missed by the position tracker.
    last_byte = session_file.stat().st_size
    _speak_latest_entry(session_file)

    while _running:
        time.sleep(WATCH_INTERVAL)

        if not session_file.exists():
            session_file = find_current_session()
            if not session_file:
                continue
            seen_ids.clear()
            last_byte = session_file.stat().st_size
            _speak_latest_entry(session_file)
            continue

        try:
            size = session_file.stat().st_size
            if size <= last_byte:
                continue

            with open(session_file) as f:
                f.seek(last_byte)
                new_lines = f.readlines()
            last_byte = size
        except (OSError, IOError):
            continue

        for line in new_lines:
            line = line.strip()
            if not line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if entry.get("type") != "assistant":
                continue
            msg = entry.get("message", {})
            msg_id = msg.get("id", "")
            if msg_id in seen_ids:
                continue

            content_blocks = msg.get("content", [])
            full_text = ""
            for block in content_blocks:
                if isinstance(block, dict) and block.get("type") == "text":
                    full_text += block.get("text", "") + "\n"
            if not full_text.strip():
                continue

            # Only mark as seen once we have valid content to speak
            seen_ids.add(msg_id)
            summary = summarize_bullets(full_text)
            if not summary:
                continue

            # Join all parts into a single utterance so VoxCPM2 generates
            # the entire audio in one pass — no gaps between sentences.
            full = " ".join(summary)
            print(f"🔊 C-3PO: {full[:80]}…", file=sys.stderr)
            speak_text(full)


# ── Daemon lifecycle ──

_running = True


def _sigterm_handler(signum, frame):
    global _running
    _running = False


def daemonize():
    pid = os.fork()
    if pid > 0:
        sys.exit(0)
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        sys.exit(0)
    PIDFILE.write_text(str(os.getpid()))
    signal.signal(signal.SIGTERM, _sigterm_handler)
    with open(os.devnull) as f:
        os.dup2(f.fileno(), sys.stdin.fileno())
    try:
        watch_session()
    finally:
        if PIDFILE.exists():
            PIDFILE.unlink()


def stop():
    if not PIDFILE.exists():
        print("claude-speak: not running", file=sys.stderr)
        return
    pid = int(PIDFILE.read_text().strip())
    try:
        os.kill(pid, signal.SIGTERM)
        print(f"claude-speak: stopped (PID {pid})", file=sys.stderr)
        PIDFILE.unlink(missing_ok=True)
    except ProcessLookupError:
        PIDFILE.unlink(missing_ok=True)


def status():
    if PIDFILE.exists():
        pid = int(PIDFILE.read_text().strip())
        try:
            os.kill(pid, 0)
            print(f"claude-speak: running (PID {pid})", file=sys.stderr)
            return
        except ProcessLookupError:
            PIDFILE.unlink(missing_ok=True)
    print("claude-speak: stopped", file=sys.stderr)


def _speak_latest_entry(session_file: Path | None = None):
    """Find and speak the most recent assistant response from the session file."""
    if session_file is None:
        session_file = find_current_session()
    if not session_file:
        return

    with open(session_file) as f:
        lines = f.readlines()

    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if entry.get("type") != "assistant":
            continue
        msg = entry.get("message", {})
        content_blocks = msg.get("content", [])
        full_text = ""
        for block in content_blocks:
            if isinstance(block, dict) and block.get("type") == "text":
                full_text += block.get("text", "") + "\n"
        if not full_text.strip():
            continue
        parts = summarize_bullets(full_text)
        if parts:
            speak_text(" ".join(parts))
        return


def speak_last_response():
    """Speak bullet points from the most recent assistant response (CLI entry)."""
    _speak_latest_entry()


def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "start":
            daemonize()
            return
        if cmd == "stop":
            stop()
            return
        if cmd == "status":
            status()
            return
        if cmd == "--last":
            speak_last_response()
            return

    # Argument is text to speak
    text = " ".join(sys.argv[1:])
    if text:
        speak_text(text)
        return

    # Default: foreground watch
    signal.signal(signal.SIGTERM, _sigterm_handler)
    watch_session()


if __name__ == "__main__":
    main()
