{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoiceRoutingConfig",
  "type": "object",
  "properties": {
    "system_settings": {
      "type": "object",
      "properties": {
        "vram_threshold_gb": { "type": "number", "minimum": 0.0 }
      },
      "required": ["vram_threshold_gb"]
    },
    "tier_routing": {
      "type": "object",
      "properties": {
        "humanoid_engine": { "type": "string", "enum": ["cosyvoice", "fishspeech"] },
        "monster_engine": { "type": "string", "enum": ["fishspeech", "cosyvoice"] }
      },
      "required": ["humanoid_engine", "monster_engine"]
    },
    "engine_endpoints": {
      "type": "object",
      "properties": {
        "cosyvoice_uri": { "type": "string", "format": "uri" },
        "fishspeech_uri": { "type": "string", "format": "uri" }
      },
      "required": ["cosyvoice_uri", "fishspeech_uri"]
    }
  },
  "required": ["system_settings", "tier_routing", "engine_endpoints"]
}
