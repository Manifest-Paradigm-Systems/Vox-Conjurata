{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NarratorSchema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "The action the narrator should perform"
    },
    "text": {
      "type": "string",
      "description": "The text to be narrated"
    },
    "voice_profile": {
      "type": "string",
      "description": "Specific voice profile ID for synthesis"
    }
  },
  "required": ["action", "text"]
}
