#!/usr/bin/env python3
"""vox2text — Ctrl+Shift+V to speak, text lands in your terminal.

Modes:
  plain          — hotkey mode: record once → notify + clipboard + append to log
  --watch        — tail ~/.vox_transcript in terminal
  --test         — test if STT endpoint is reachable
  --debug        — extra verbosity to stderr
  --list-devices — list audio input devices
"""

import argparse
import io
import os
import struct
import subprocess
import sys
import time
import wave
from datetime import datetime
from pathlib import Path

import numpy as np
import pyaudio
import requests

# ── Config ────────────────────────────────────────────────────────────────
STT_URL = os.getenv("VOX_STT_URL", "http://localhost:5000/v1/audio/transcriptions")
TRANSCRIPT_LOG = Path(os.getenv("VOX_LOG", Path.home() / ".vox_transcript"))

RATE = 16000          # Whisper expects 16 kHz
CHUNK = 1024          # frames per buffer read
FORMAT = pyaudio.paInt16
CHANNELS = 1

SILENCE_THRESHOLD = 500   # RMS below this = silence
SILENCE_DURATION = 1.5    # seconds of silence to cut off
MAX_RECORD_SEC = 30       # safety cap


# ── Audio helpers ─────────────────────────────────────────────────────────

def rms(data: bytes) -> float:
    """Root-mean-square of raw int16 PCM (0–32768 scale)."""
    count = len(data) // 2
    if count == 0:
        return 0.0
    samples = struct.unpack(f"<{count}h", data)
    return float(np.sqrt(np.mean(np.square(samples))))


def find_good_device(pa: pyaudio.PyAudio) -> int:
    """Auto-pick the best mic (prefer USB headsets, fall back to default)."""
    best = None
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] == 0:
            continue
        name = info["name"]
        if "EKSA" in name or "Headset" in name or "Microphone" in name:
            best = i
            # Keep looking — prefer the first one with "EKSA"
        if "EKSA" in name:
            best = i
            break
    # Fallback: default input device
    if best is None:
        best = pa.get_default_input_device_info()["index"]
    return best


def record_utterance(pa: pyaudio.PyAudio, device: int) -> bytes:
    """Record until silence-detected (or timeout), return raw PCM bytes."""
    stream = pa.open(
        format=FORMAT, channels=CHANNELS, rate=RATE,
        input=True, input_device_index=device,
        frames_per_buffer=CHUNK,
    )
    frames: list[bytes] = []
    silent_blocks = 0
    silence_needed = int(SILENCE_DURATION * RATE / CHUNK)
    max_blocks = int(MAX_RECORD_SEC * RATE / CHUNK)
    recording = False
    lead_in = 0

    for _ in range(max_blocks):
        data = stream.read(CHUNK, exception_on_overflow=False)
        level = rms(data)

        # skip initial mic pop
        if lead_in < 4:
            lead_in += 1
            frames.append(data)
            continue

        # start of speech
        if not recording and level > SILENCE_THRESHOLD:
            recording = True
            silent_blocks = 0
            frames.append(data)
            continue

        if not recording:
            # keep a small rolling buffer so we don't clip the utterance start
            frames.append(data)
            if len(frames) > int(0.5 * RATE / CHUNK):
                frames.pop(0)
            continue

        # recording — track silence
        frames.append(data)
        if level < SILENCE_THRESHOLD:
            silent_blocks += 1
        else:
            silent_blocks = 0

        if silent_blocks >= silence_needed:
            # trim trailing silence
            trim = silent_blocks * CHUNK
            tail = b"".join(frames)
            if trim < len(tail):
                tail = tail[:-trim]
            frames = [tail]
            break

    stream.stop_stream()
    stream.close()

    if not recording:
        return b""
    return b"".join(frames)


def transcribe(pcm_data: bytes) -> str:
    """Send PCM to vox-voice, return transcription text."""
    buf = io.BytesIO()
    with wave.open(buf, "wb") as wf:
        wf.setnchannels(CHANNELS)
        wf.setsampwidth(2)
        wf.setframerate(RATE)
        wf.writeframes(pcm_data)
    wav_bytes = buf.getvalue()

    resp = requests.post(
        STT_URL,
        files={"file": ("voice.wav", wav_bytes, "audio/wav")},
        data={"model_name": "base", "language": "en"},
        timeout=30,
    )
    resp.raise_for_status()
    return resp.json().get("text", "").strip()


# ── Output / UI helpers ───────────────────────────────────────────────────

def notify(title: str, body: str, urgency: str = "normal"):
    """Desktop notification."""
    subprocess.run(
        ["notify-send", f"--urgency={urgency}", title, body],
        timeout=5,
    )


def copy_clipboard(text: str):
    """Copy to Wayland clipboard (wl-clipboard)."""
    subprocess.run(["wl-copy"], input=text.encode(), timeout=5)


def append_log(text: str):
    """Append timestamped line to transcript log."""
    ts = datetime.now().strftime("%H:%M:%S")
    line = f"[{ts}] {text}\n"
    TRANSCRIPT_LOG.parent.mkdir(parents=True, exist_ok=True)
    with TRANSCRIPT_LOG.open("a") as f:
        f.write(line)


# ── Modes ─────────────────────────────────────────────────────────────────

def hotkey_mode(device: int):
    """Record → transcribe → notify + clipboard + log.  (Invoked by KDE hotkey.)"""
    pa = pyaudio.PyAudio()
    try:
        notify("🎤 vox2text", "Listening...", "low")
        pcm = record_utterance(pa, device)
        if not pcm:
            notify("vox2text", "No speech detected", "low")
            return
        text = transcribe(pcm)
        if not text:
            notify("vox2text", "No transcription (silent?)", "low")
            return
        copy_clipboard(text)
        append_log(text)
        notify("📝 vox2text", text, "normal")
    finally:
        pa.terminate()


def watch_mode():
    """Tail the transcript log to terminal (run this in a terminal)."""
    if not TRANSCRIPT_LOG.exists():
        TRANSCRIPT_LOG.write_text("")
    print(f"📝 vox2text — watching {TRANSCRIPT_LOG}")
    print("   Press Ctrl+Shift+V anywhere to speak, text appears here.")
    print("─" * 60)
    with TRANSCRIPT_LOG.open("r") as f:
        # seek to end
        f.seek(0, 2)
        while True:
            line = f.readline()
            if line:
                sys.stdout.write(line)
                sys.stdout.flush()
            else:
                time.sleep(0.1)


def test_mode():
    """Check STT endpoint."""
    try:
        resp = requests.get(STT_URL.replace("/v1/audio/transcriptions", "/"), timeout=5)
        print(f"✅ vox-voice STT: {resp.json()}")
    except Exception as e:
        print(f"❌ Cannot reach vox-voice: {e}")
    # Check mic
    pa = pyaudio.PyAudio()
    dev = find_good_device(pa)
    info = pa.get_device_info_by_index(dev)
    print(f"🎤 Mic: [{dev}] {info['name']}")
    pa.terminate()


def list_devices():
    """Print all audio input devices."""
    pa = pyaudio.PyAudio()
    found = False
    for i in range(pa.get_device_count()):
        info = pa.get_device_info_by_index(i)
        if info["maxInputChannels"] > 0:
            print(f"  {i}: {info['name']}  (ch={info['maxInputChannels']}, sr={int(info['defaultSampleRate'])})")
            found = True
    if not found:
        print("  (no input devices found)")
    pa.terminate()


# ── Main ──────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(description="vox2text — speak, see text in terminal")
    parser.add_argument("--watch", action="store_true", help="Tail transcript log in terminal")
    parser.add_argument("--test", action="store_true", help="Check STT + mic")
    parser.add_argument("--list-devices", action="store_true", help="List audio inputs")
    parser.add_argument("--debug", action="store_true", help="Verbose stderr")
    args = parser.parse_args()

    if args.debug:
        global SILENCE_THRESHOLD
        SILENCE_THRESHOLD = 200

    if args.test:
        test_mode()
        return

    if args.list_devices:
        list_devices()
        return

    if args.watch:
        watch_mode()
        return

    # Default: hotkey mode
    pa = pyaudio.PyAudio()
    device = find_good_device(pa)
    pa.terminate()

    if args.debug:
        print(f"🎤 Using device {device}", file=sys.stderr)

    hotkey_mode(device)


if __name__ == "__main__":
    main()
