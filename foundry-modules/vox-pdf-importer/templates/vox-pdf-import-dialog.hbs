<form class="flexcol">
  <section>
    <h2>{{localize "VOXPDF.Title"}}</h2>
    <hr>

    {{! System selector }}
    <div class="form-group">
      <label>{{localize "VOXPDF.Settings.GameSystem"}}</label>
      <div class="form-fields">
        <select class="vox-pdf-system-select">
          {{#each systems}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="notes">Detected: {{systemDetected}}</p>
    </div>

    <hr>

    {{! Queue controls }}
    <div class="form-group">
      <label>{{localize "VOXPDF.Queue"}}</label>
      <div class="form-fields">
        <button type="button" class="vox-pdf-add-btn">
          <i class="fas fa-plus"></i> Add PDFs
        </button>
      </div>
    </div>

    <div class="vox-pdf-queue-list">
      <p class="notes">No PDFs in queue. Click "Add PDFs" to begin.</p>
    </div>

    <hr>

    {{! Options }}
    <div class="form-group">
      <label>{{localize "VOXPDF.Settings.CreateScenes"}}</label>
      <div class="form-fields"><input type="checkbox" name="createScenes" checked></div>
    </div>
    <div class="form-group">
      <label>{{localize "VOXPDF.Settings.CreateJournals"}}</label>
      <div class="form-fields"><input type="checkbox" name="createJournals" checked></div>
    </div>

    <hr>

    <button type="button" class="vox-pdf-start-queue">
      <i class="fas fa-brain"></i> Start Enchantment
    </button>
  </section>
</form>
