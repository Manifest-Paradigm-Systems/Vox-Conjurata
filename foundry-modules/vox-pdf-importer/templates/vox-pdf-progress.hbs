<form class="flexcol">
  <section>
    <div class="form-group">
      <label>{{localize "VOXPDF.Progress"}}</label>
      <div class="form-fields">
        <div class="vox-pdf-progress-bar">
          <div class="vox-pdf-progress-fill" style="width: {{percent}}%"></div>
        </div>
      </div>
      <p class="notes">{{currentPage}} / {{totalPages}} pages ({{percent}}%)</p>
    </div>

    <div class="form-group">
      <label>{{localize "VOXPDF.Status"}}</label>
      <p class="notes" id="vox-pdf-status">{{status}}</p>
    </div>

    <hr>

    <div class="vox-pdf-stats">
      <div class="vox-pdf-stat">
        <span class="vox-pdf-stat-label">{{localize "VOXPDF.Success"}}</span>
        <span class="vox-pdf-stat-value success">{{successCount}}</span>
      </div>
      <div class="vox-pdf-stat">
        <span class="vox-pdf-stat-label">{{localize "VOXPDF.Skipped"}}</span>
        <span class="vox-pdf-stat-value skipped">{{skippedCount}}</span>
      </div>
      <div class="vox-pdf-stat">
        <span class="vox-pdf-stat-label">{{localize "VOXPDF.Errors"}}</span>
        <span class="vox-pdf-stat-value error">{{errorCount}}</span>
      </div>
    </div>

    <button type="button" class="vox-pdf-cancel-btn">
      <i class="fas fa-times"></i> {{localize "VOXPDF.Cancel"}}
    </button>
  </section>
</form>
